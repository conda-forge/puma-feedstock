diff --git a/cpp/src/utilities/puma_posix_compat.h b/cpp/src/utilities/puma_posix_compat.h
new file mode 100644
index 0000000..8d0a69f
--- /dev/null
+++ b/cpp/src/utilities/puma_posix_compat.h
@@ -0,0 +1,42 @@
+#ifndef PUMA_POSIX_COMPAT_H
+#define PUMA_POSIX_COMPAT_H
+
+// PuMA was written against POSIX. This header is the one place that maps the
+// handful of POSIX names it uses onto what the Microsoft C runtime provides,
+// so the rest of the sources can stay as they are.
+
+#include <sys/types.h>
+#include <fcntl.h>
+
+#ifdef _WIN32
+
+#include <BaseTsd.h>
+#include <cstdint>
+#include <direct.h>  // getcwd
+#include <io.h>      // open, read, write, lseek, close
+#include <sys/stat.h> // _S_IREAD, _S_IWRITE
+
+typedef SSIZE_T ssize_t;
+typedef uint16_t u_int16_t;
+typedef uint32_t u_int32_t;
+typedef uint64_t u_int64_t;
+
+#ifndef __PRETTY_FUNCTION__
+#define __PRETTY_FUNCTION__ __FUNCSIG__
+#endif
+
+// The CRT opens files in text mode unless told otherwise, which would rewrite
+// every 0x0A byte of a binary STL file, and it rejects POSIX permission bits.
+#define PUMA_O_BINARY _O_BINARY
+#define PUMA_CREAT_MODE (_S_IREAD | _S_IWRITE)
+
+#else
+
+#include <unistd.h>
+
+#define PUMA_O_BINARY 0
+#define PUMA_CREAT_MODE 0644
+
+#endif
+
+#endif // PUMA_POSIX_COMPAT_H
